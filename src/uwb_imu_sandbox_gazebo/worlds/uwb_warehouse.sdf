        <visual name="v1"><pose>-3.000 -0.460 0.000 0 0 0</pose><geometry><box><size>0.08 0.08 2.4</size></box></geometry><material><ambient>0.95 0.45 0.08 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse></material></visual>
