<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uwb_imu_sandbox</name>
  <version>0.1.0</version>
  <description>UWB-IMU Sandbox: ROS 2 nodes, bridge and launch files for testing indoor UWB + IMU localization in Gazebo with realistic sensor plugins.</description>
  <maintainer email="24110177@iitgn.ac.in">Kush Mehta</maintainer>
  <maintainer email="parshvapatel1456@gmail.com">Parshva Patel</maintainer>
  <license>Apache-2.0</license>
  <author>Parshva Patel</author>
  <author>Kush Mehta</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>uwb_imu_sandbox_msgs</exec_depend>
  <exec_depend>uwb_imu_sandbox_gazebo</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
